{
  "policyVersion": "runtime-policy-v1",
  "ruleVersion": "rule-runtime-v1",
  "runtimeModel": "roberta",
  "modelVersion": "roberta-v5",
  "weights": {
    "rule": 0.3,
    "roberta": 0.5,
    "context": 0.2
  },
  "thresholds": {
    "warn": 0.3,
    "block": 0.7
